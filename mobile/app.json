{
  "expo": {
    "name": "TezzNirmaan",
    "slug": "tezznirmaan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tezznirmaan",
    "platforms": ["ios", "android"],

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8521A"
    },

    "assetBundlePatterns": ["**/*"],

    "android": {
      "package": "in.tezznirmaan.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8521A"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tezznirmaan.in",
              "pathPrefix": "/order"
            },
            {
              "scheme": "tezznirmaan"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },

    "ios": {
      "bundleIdentifier": "in.tezznirmaan.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TezzNirmaan needs your location to find nearby shops and deliver to your address.",
        "NSLocationAlwaysUsageDescription": "TezzNirmaan uses your location for accurate delivery.",
        "NSCameraUsageDescription": "Used for profile photo.",
        "NSPhotoLibraryUsageDescription": "Used to select profile photo."
      }
    },

    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-location",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#E8521A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E8521A",
          "defaultChannel": "general",
          "sounds": ["./assets/sounds/order-alert.wav"]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "note": "Set SENTRY_AUTH_TOKEN in CI to upload source maps"
        }
      ]
    ],

    "updates": {
      "url": "https://u.expo.dev/YOUR_EAS_PROJECT_ID",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "extra": {
      "eas":              { "projectId": "YOUR_EAS_PROJECT_ID" },
      "apiBaseUrl":       "https://api.tezznirmaan.in/api/v1",
      "supabaseUrl":      "YOUR_SUPABASE_URL",
      "supabaseAnonKey":  "YOUR_SUPABASE_ANON_KEY",
      "sentryDsn":        "YOUR_SENTRY_DSN",
      "razorpayKeyId":    "YOUR_RAZORPAY_KEY_ID"
    },

    "owner": "mantu-09"
  }
}
