# TezzNirmaan Mobile App — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Backend API
EXPO_PUBLIC_API_BASE_URL=https://tezznirmaan-api.onrender.com/api/v1

# WebSocket (P5-1) — same host as the API, different protocol (wss://)
# In dev: ws://localhost:3000/ws
# In prod: wss://tezznirmaan-api.onrender.com/ws
EXPO_PUBLIC_WS_URL=wss://tezznirmaan-api.onrender.com/ws

# Supabase (for push notification subscriptions only — regular data goes through backend API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Razorpay (public key only — secret key is NEVER in the mobile app)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# ── Support Chat — Freshchat (P7-4) ──────────────────────────────────────────
# Setup:
#   1. Create a free account at https://freshchat.com (free plan: up to 10 agents)
#   2. Settings → Mobile SDK → copy App ID and App Key into the vars below
#   3. Settings → Channels → Mobile → enable iOS + Android
#   4. Create an Inbox called "Order Issues" (tag: order-issue) and
#      an Inbox called "General Support" (tag: general)
# Leave BLANK to use WhatsApp fallback (EXPO_PUBLIC_SUPPORT_WHATSAPP) instead.
EXPO_PUBLIC_FRESHCHAT_APP_ID=
EXPO_PUBLIC_FRESHCHAT_APP_KEY=

# WhatsApp fallback: Founder's number in international format without + or dashes
# e.g. 919876543210 for +91 98765 43210
# Used when Freshchat is not configured or unavailable.
EXPO_PUBLIC_SUPPORT_WHATSAPP=91XXXXXXXXXX

# ── CDN Image Delivery — Cloudflare R2 (P7-5) ────────────────────────────────
# The CDN base URL used by ProductImage to resolve stored R2 keys into full URLs.
# Example: "products/uuid.jpg" → "https://images.tezznirmaan.in/products/uuid.jpg"
# Use pub-xxx.r2.dev during setup (before custom domain is configured).
# Leave BLANK if images are stored as full URLs (legacy Supabase Storage).
EXPO_PUBLIC_R2_CDN_URL=https://images.tezznirmaan.in
