# ======================
# Server
# ======================
PORT=3000
NODE_ENV=development

# ======================
# Supabase
# ======================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# B7: DB Connection Pooling
# For direct Postgres queries (pg package), always use the POOLER URL
# (Transaction mode, port 6543) NOT the direct URL (port 5432).
# Find in: Supabase Dashboard → Project Settings → Database → Connection Pooling
# SUPABASE_DB_POOLER_URL=postgresql://postgres.xxx:DB_PASS@aws-x.pooler.supabase.com:6543/postgres
# SUPABASE_DB_DIRECT_URL=postgresql://postgres.xxx:DB_PASS@db.xxx.supabase.co:5432/postgres

# ======================
# Auth / JWT
# ======================
JWT_SECRET=your-jwt-secret

# ======================
# Razorpay
# ======================
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ======================
# CORS
# ======================
# Comma-separated list of allowed origins. Include all frontend origins.
# Development: backend (3000) + dashboard (3001) + Expo dev server
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,exp://localhost:8081

# ======================
# SMS — Fast2SMS (B1)
# Get your key: https://www.fast2sms.com/dashboard/api-credentials
# Free tier: 500 SMS on signup. No DLT needed for transactional route.
# Leave blank to disable SMS (notifications still work via in-app Realtime).
# ======================
FAST2SMS_API_KEY=

# ======================
# Redis — Upstash (B7)
# Free tier: 10,000 commands/day, 256MB, works from Render.
# Setup: https://console.upstash.com → Create database → REST API tab
# Leave BLANK in development — the app uses an in-memory mock automatically.
# ======================
UPSTASH_REDIS_REST_URL=https://YOUR_DB_NAME.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# ======================
# Redis — ioredis / Socket.IO adapter (P6-1)
# REQUIRED for horizontal WebSocket scaling (multi-instance on Render).
# Without this, order events only broadcast within one server instance.
# Uses TCP pub/sub (ioredis) — different from the @upstash/redis REST client above.
# Find in: Upstash Console → Database → Details → "ioredis" connection string
# Format: rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
#   Note the double-s in rediss:// — this is TLS, required by Upstash.
# LEAVE BLANK in development — Socket.IO runs in single-instance mode automatically.
# ======================
REDIS_URL=

# ======================
# Push Notifications — Expo (P1-A)
# Without EXPO_ACCESS_TOKEN: rate limit is 600 push/min (enough for dev).
# With EXPO_ACCESS_TOKEN: rate limit is 6,000 push/min (required for prod).
# Get your token: https://expo.dev/accounts/[username]/settings/access-tokens
# Create a token with "Push Notification" scope.
# ======================
EXPO_ACCESS_TOKEN=your-expo-access-token

# ======================
# Claude AI — P5-2
# ======================
# Get your key: https://console.anthropic.com → API Keys
# Enables: personalised recommendations, demand forecasting, Hinglish search
# Leave BLANK to disable AI features gracefully (app still works without it).
# ======================
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# ======================
# Job Queue — pg-boss (P1-E)
# pg-boss holds persistent long-lived connections — use SESSION pooler (port 5432).
# DO NOT use Transaction pooler (port 6543) — pg-boss will fail with ENOTFOUND.
# Find in: Supabase Dashboard → Connect button → "Session pooler" tab.
# Leave BLANK in local dev — the queue gracefully disables itself and falls back
# to synchronous fire-and-forget delivery.
# Format: postgresql://postgres.[ref]:[pass]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# ======================
DATABASE_URL=

# ======================
# DLQ Alerting — P5-4B
# If set, the daily dead-letter-queue check SMSes this number if any background
# jobs have failed in the last 24h. Uses the Fast2SMS gateway (FAST2SMS_API_KEY
# must also be set). Use Indian mobile number format: +91XXXXXXXXXX or XXXXXXXXXX.
# ======================
FOUNDER_PHONE=

# ======================
# Typesense Search — P6-5
# Sub-50ms search with typo tolerance and faceting.
# Without these vars: falls back to PostgreSQL FTS (search still works).
#
# Option A — Typesense Cloud (recommended):
#   1. Sign up at https://cloud.typesense.org (free 14-day trial)
#   2. Create a cluster → choose "Shared" ($6/mo) for production
#   3. Copy "Hostname" → TYPESENSE_HOST  (e.g. xyz.a1.typesense.net)
#   4. Copy "Admin API Key"  → TYPESENSE_ADMIN_API_KEY
#   5. Generate a Search-Only key → TYPESENSE_SEARCH_API_KEY
#   6. Run the indexing script once:
#        node --env-file=.env src/scripts/index-products.js
#
# Option B — Self-host on Render (free tier):
#   docker run -p 8108:8108 typesense/typesense:26.0 \
#     --data-dir /data --api-key=your-key --enable-cors
#   Then set TYPESENSE_HOST=your-render-service.onrender.com and port 443.
# ======================
TYPESENSE_HOST=
TYPESENSE_ADMIN_API_KEY=
TYPESENSE_SEARCH_API_KEY=

# ======================
# Freshchat — P7-4
# Used by the admin dashboard to show the unread conversation badge count.
# Get it: Freshchat dashboard → Settings → API → Create token (Server key)
# Leave BLANK — the badge just stays at 0 without it.
# ======================
FRESHCHAT_API_TOKEN=

# ======================
# Cloudflare R2 — P7-5: CDN Image Delivery
#
# Setup (one-time, takes ~15 minutes):
#   1. dash.cloudflare.com → R2 → Create bucket → name: tezznirmaan-images
#   2. Bucket settings → Public access → Allow Access → get pub-xxx.r2.dev URL
#   3. Custom domain → images.tezznirmaan.in → CNAME to pub-xxx.r2.dev
#      (or skip custom domain and use the pub-xxx.r2.dev URL directly)
#   4. R2 → Manage R2 API Tokens → Create token:
#      Permissions: Object Read & Write | Bucket: tezznirmaan-images
#      → Copy Account ID, Access Key ID, Secret Access Key
#
# Egress cost: $0 (R2 has no egress fees, unlike S3)
# Storage cost: $0.015/GB/month
# Leave ALL BLANK to disable image upload (endpoint returns 503)
# ======================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tezznirmaan-images
R2_CDN_URL=https://images.tezznirmaan.in
